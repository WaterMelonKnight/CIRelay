{
  "name": "cirelay",
  "version": "0.1.0",
  "private": true,
  "description": "CI feedback infrastructure for AI coding agents",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "vitest run",
    "pack:check": "node scripts/package-smoke.mjs",
    "smoke:github": "node scripts/github-actions-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
